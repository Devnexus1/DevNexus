# ---------- امنیت ----------
# یک مقدار تصادفی بگذار:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---------- ایمیل (Gmail) ----------
# MAIL_PASSWORD باید «App Password» گوگل باشد (نه رمز اصلی حساب)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=your-address@gmail.com

# ایمیلی که اعلان پیام جدید به آن می‌رسد (باید یک ایمیل واقعی باشد، نه متن)
ADMIN_EMAIL=your-address@gmail.com

# ---------- اعلان روی گوشی (اختیاری) ----------
# پیامک با کاوه‌نگار: هر دو مقدار پر شوند تا فعال شود
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
ADMIN_PHONE=

# تلگرام: توکن ربات از BotFather و chat id خودت
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
